{
  "expo": {
    "name": "DRIVE ALERT by Denisa",
    "slug": "drive-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drive-alert",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "La fotocamera anteriore analizza localmente i segnali del volto per rilevare possibili segni di stanchezza.",
        "NSLocationWhenInUseUsageDescription": "La posizione viene usata quando apri la ricerca delle soste per mostrare la velocità e trovare suggerimenti nelle vicinanze."
      }
    },
    "android": {
      "package": "com.denisa.drivealert",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./store/assets/adaptive-icon-foreground.png",
        "backgroundColor": "#081526"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La posizione viene usata quando apri la ricerca delle soste per mostrare la velocità e trovare suggerimenti nelle vicinanze."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
